# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# Configure your keys securely via the Secrets panel in Google AI Studio.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENAI_API_KEY: Optional key for OpenAI ChatGPT provider in the Three AI Brain System.
OPENAI_API_KEY=MY_OPENAI_API_KEY

# OPENROUTER_API_KEY: Optional key for OpenRouter / Custom Cloud AI provider.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
